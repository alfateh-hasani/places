  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Request Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{client_id}}\",\n  \"clientSecret\": \"{{client_secret}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/oauth2/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            },
            "description": "Obtain a 24-hour bearer token. The quick start guide recommends caching this response and refreshing only after expiry to respect the five-token-per-day cap."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stored access token for reuse', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data).to.have.property('access_token');",
                  "  pm.collectionVariables.set('access_token', data.access_token);",
                  "  const expiresIn = data.expires_in || (24 * 60 * 60);",
                  "  const expiresAt = Math.floor(Date.now() / 1000) + expiresIn;",
                  "  pm.collectionVariables.set('access_token_expires_at', expiresAt.toString());",
                  "});",
                  "if (!pm.response.json().access_token) {",
                  "  console.warn('Token missing in response.');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
